#!/usr/bin/env python3
"""Escape helper for Vector Bar.

Bound to Escape in Hyprland:
  1. Close the Vector Bar settings panel if it is open.
  2. Else if Vector is the focused window, hide it (--hide).
  3. Else forward Escape to the focused surface so other apps and Omarchy
     layer-shell panels still receive it (same send_key_state pattern as
     Omarchy's universal clipboard binds).
"""
import json
import os
import subprocess
import sys

CLASS = "Vector"
PLUGIN = "io.github.bonesgit.omarchy-vector-bar"
TOGGLE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "vector-toggle")


def close_settings_panel() -> bool:
    try:
        r = subprocess.run(
            ["omarchy-shell", PLUGIN, "closeSettings"],
            capture_output=True,
            text=True,
            timeout=2,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        return False
    return (r.stdout or "").strip() == "closed"


def main():
    if close_settings_panel():
        return 0

    r = subprocess.run(
        ["hyprctl", "activewindow", "-j"], capture_output=True, text=True
    )
    try:
        w = json.loads(r.stdout or "{}")
    except Exception:
        w = {}

    if w.get("class") == CLASS:
        subprocess.run([TOGGLE, "--hide"])
        return 0

    # Pass Escape through (down + delayed up — avoids stuck synthetic keys).
    subprocess.run(
        [
            "hyprctl",
            "eval",
            'hl.dispatch(hl.dsp.send_key_state({ mods = "", key = "Escape", state = "down" }))\n'
            "hl.timer(function()\n"
            '  hl.dispatch(hl.dsp.send_key_state({ mods = "", key = "Escape", state = "up" }))\n'
            'end, { timeout = 50, type = "oneshot" })',
        ],
        capture_output=True,
        text=True,
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
